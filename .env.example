# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity (leave empty to use src/lib/data/defaults.ts; re-seed after enabling)
# If the site shows wrong name (e.g. Alex Rivera), run: npm run seed:sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

# Email
RESEND_API_KEY=
CONTACT_EMAIL=ceo@orcrys.com
FROM_EMAIL=noreply@yourdomain.com

# Founder actions (optional)
# PDF at public/resume/debanjan-sandhaki-resume.pdf or override URL:
NEXT_PUBLIC_RESUME_URL=
# Calendly or similar scheduling link:
NEXT_PUBLIC_CALENDAR_URL=
# Optional inline embed (overrides auto ?embed=true on CALENDAR_URL):
NEXT_PUBLIC_CALENDAR_EMBED_URL=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Monitoring
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
